# Add the real values only in Cloud Secrets. Never commit a .env file.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Optional: comma-separated Telegram group IDs that may receive emoji reactions.
# Leave empty until the test group is approved.
ALLOWED_CHAT_IDS=

# Optional. The default is gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
